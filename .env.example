# ─────────────────────────────────────────────────────────────────────────────
# Ziada POS — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
# Generate a new secret: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated hosts e.g. "localhost,127.0.0.1,yourdomain.com"
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL URL format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://ziada:ziada@localhost:5432/ziada_db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Access token lifetime in minutes (default 60)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# Refresh token lifetime in days (default 7)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── AI / OpenRouter ───────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use for MVP (cheap + fast). Options:
#   openai/gpt-4o-mini      ← MVP default (very cheap)
#   anthropic/claude-3-haiku  ← Good alternative
#   meta-llama/llama-3-8b-instruct  ← Free tier option
OPENROUTER_MODEL=openai/gpt-4o-mini

# Site URL sent to OpenRouter for ranking (optional but recommended)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Ziada POS

# ── Email (optional for now) ──────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

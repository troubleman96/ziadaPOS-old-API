# ─────────────────────────────────────────────────────────────────────────────
# Ziada POS — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────
# Generate a new secret: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated hosts e.g. "localhost,127.0.0.1,yourdomain.com"
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL URL format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Under docker-compose, DATABASE_URL is overridden to point at the `db`
# service automatically — POSTGRES_DB/USER/PASSWORD below are what actually
# provision that container, so keep them in sync with the URL's user/pass.
DATABASE_URL=postgres://ziada:ziada@localhost:5432/ziada_db
POSTGRES_DB=ziada_db
POSTGRES_USER=ziada
POSTGRES_PASSWORD=change-me-strong-password

# Production settings require SSL to Postgres by default (e.g. a managed
# cloud DB). Set to False for a local/same-network Postgres with SSL off —
# docker-compose.yml already sets this automatically for its `db` service.
DATABASE_SSL_REQUIRE=True

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Access token lifetime in minutes (default 60)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# Refresh token lifetime in days (default 7)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── AI / Ngamia ───────────────────────────────────────────────────────────────
# Ngamia is an OpenAI-compatible AI gateway billed in TZS credits.
# Register + create a key at https://docs.ngamia.cc (see /quickstart).
NGAMIA_API_KEY=ngm_your-key-here

# Model to use, as "{provider}/{model_code}" — see GET /v1/models for the
# full catalog. Default is cheap + fast, good for MVP.
NGAMIA_MODEL=openrouter/openai/gpt-4o-mini

# ── Email ─────────────────────────────────────────────────────────────────────
# Set to smtp.EmailBackend in production (ZohoMail SMTP)


# Daily report schedule (Africa/Dar_es_Salaam, 24h clock)
DAILY_REPORT_HOUR=22
DAILY_REPORT_MINUTE=0

# ── SMS / SendAfrica ──────────────────────────────────────────────────────────
# Platform's own key — sends auth OTPs (phone verification) only. Each
# organisation's own customer-facing SMS key is set in-app (Settings →
# Integrations), not here. Get a key at https://docs.sendafrica.online
SENDAFRICA_PLATFORM_API_KEY=

# ── MinIO Object Storage ───────────────────────────────────────────────────────
# MinIO speaks the S3 protocol — boto3 handles it natively via django-storages.
# Set USE_MINIO=True in production once the server Nginx config is in place.
# See deploy.md § MinIO for the required server-side setup.

